# ═════════════════════════════════════════════════════════════════
# STUDYINDIA GLOBAL — ENVIRONMENT CONFIGURATION
# ═════════════════════════════════════════════════════════════════

# ── CENTRALIZED DEMO MODE (FEATURE FLAG) ────────────────────────
# Set to 'true' to run the entire application locally with mock datasets.
# When true, NO Clerk keys, Supabase credentials, or PostgreSQL DATABASE_URL
# are required. The entire site, dashboards, search, and forms work out of the box.
# Set to 'false' to re-enable production cloud integrations.
NEXT_PUBLIC_DEMO_MODE=true

# ── 1. DATABASE (POSTGRESQL / SUPABASE / NEON) ───────────────────
# Required when NEXT_PUBLIC_DEMO_MODE=false
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ── 2. CLERK AUTHENTICATION ─────────────────────────────────────
# Required when NEXT_PUBLIC_DEMO_MODE=false
# Sign up at https://clerk.com and create an application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/student/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/student/onboarding"

# ── 3. SUPABASE STORAGE (STUDENT DOCUMENT VAULT) ────────────────
# Required when NEXT_PUBLIC_DEMO_MODE=false
# Get from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_STUDENT_DOCS_BUCKET="student-documents"

# ── 4. ADMIN & APPLICATION URL ──────────────────────────────────
ADMIN_EMAILS="admin@studyindia.global,admissions@studyindia.global"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
