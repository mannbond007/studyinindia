# ═════════════════════════════════════════════════════════════════
# STUDYINDIA GLOBAL — .GITIGNORE CONFIGURATION
# ═════════════════════════════════════════════════════════════════

# ── Dependencies ────────────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js Build Outputs & Caches ───────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── Environment & Secret Files (CRITICAL: Never commit secrets) ──
.env
.env*.local
.env.development
.env.test
.env.production
*.env

# Whitelist environment configuration template for team/deployment setup
!.env.example

# ── Logs & Debugging ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
next-panic-*.log

# ── Testing & Coverage ───────────────────────────────────────────
coverage/
.nyc_output/

# ── Prisma Generated Artifacts & Local DBs ───────────────────────
/app/generated/prisma
prisma/*.db
prisma/*.db-journal
prisma/*.sqlite
prisma/*.sqlite-journal

# ── OS Generated Files ───────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~

# ── IDEs & Code Editors ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ── Temporary, Scratch & Backup Files ────────────────────────────
*.bak
*.backup
*.backup.*
*.tmp
*.temp
*.orig
scratch/

# ── Vercel Deployment Metadata ───────────────────────────────────
.vercel
